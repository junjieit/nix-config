#!/bin/sh
set -eu

config_home=${XDG_CONFIG_HOME:-"$HOME/.config"}
config_dir="$config_home/hypr"

for binary in Hyprland luac lua ghostty dolphin rofi grim slurp swappy cliphist wl-copy hyprlock neovide wpctl mpc keepassxc bluetoothctl; do
    command -v "$binary" >/dev/null || {
        printf 'Missing required command: %s\n' "$binary" >&2
        exit 1
    }
done

lua "$config_dir/scripts/verify-services.lua" "$config_dir"

for script in "$config_dir/scripts/workspace-group" "$config_dir/scripts/xdg-desktop-portal.sh"; do
    test -x "$script" || {
        printf 'Missing or non-executable local script: %s\n' "$script" >&2
        exit 1
    }
done

find "$config_dir/modules" -name '*.lua' -type f -print0 | xargs -0 -n1 luac -p
luac -p "$config_dir/hyprland.lua"
Hyprland --verify-config
"$config_dir/tests/workspace-group-test.sh"
